# --- Base de données ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plugin_dz?schema=public"

# --- Serveur ---
PORT=4000
NODE_ENV=development
# Origines autorisées pour le CORS (séparées par des virgules)
CORS_ORIGINS="http://localhost:3000"
# URL publique de l'API (sert à construire les URLs d'images uploadées)
PUBLIC_API_URL="http://localhost:4000"

# --- Authentification admin ---
JWT_SECRET="change-moi-en-production"
JWT_EXPIRES_IN="12h"

# --- Compte propriétaire créé au seed ---
OWNER_EMAIL="admin@plugin.dz"
OWNER_PASSWORD="plugin2024"
OWNER_NAME="Propriétaire Plugin"

# --- Email de notification de commande (Resend) ---
# Clé API Resend : https://resend.com/api-keys . Vide en dev = emails journalisés en console.
RESEND_API_KEY=""
# Expéditeur. onboarding@resend.dev fonctionne immédiatement (n'écrit qu'au propriétaire
# du compte Resend). Pour écrire à n'importe qui, vérifiez votre domaine dans Resend puis
# mettez par ex. "Plugin.dz <no-reply@plugin.dz>".
MAIL_FROM="Plugin.dz <onboarding@resend.dev>"
# Destinataire des notifications de nouvelle commande (mettez votre email).
ORDER_NOTIFICATION_EMAIL="commandes@plugin.dz"

# --- Uploads ---
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=5
